\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Открытые поля, густо усеянные проходимыми, но штрафуемыми опасностями (плотность $0.20$); маршрут свидетеля избегает опасностей по опыту; 20 парных миров, затухание выключено (ось безопасности изолирована от оси старения). Оба режима переноса ЗАВЕРШАЮТ задачу --- ось стен (табл.~\ref {tab:cliff}) и ось опасностей независимы; различается цена.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:hazard}{{2}{4}{Открытые поля, густо усеянные проходимыми, но штрафуемыми опасностями (плотность $0.20$); маршрут свидетеля избегает опасностей по опыту; 20 парных миров, затухание выключено (ось безопасности изолирована от оси старения). Оба режима переноса ЗАВЕРШАЮТ задачу --- ось стен (табл.~\ref {tab:cliff}) и ось опасностей независимы; различается цена}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Песня защищает. \textbf  {(a)} Попадания в опасности за эпизод: путник на маршруте свидетеля наследует его безопасность целиком ($0$ во всех 20 мирах); путник с одними местами платит $3.25$ попадания за то же завершение; слепое исследование платит $28.7$. \textbf  {(b)} Композиция с законом разрыва: в режиме разрыва путник не получает ни одного попадания, пока длится песня, а после разрыва риск возобновляется --- и разрыв происходит на предсказанном экспериментом R2 индексе ребра во всех $19/19$ ячейках.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:hazard}{{2}{5}{Песня защищает. \textbf {(a)} Попадания в опасности за эпизод: путник на маршруте свидетеля наследует его безопасность целиком ($0$ во всех 20 мирах); путник с одними местами платит $3.25$ попадания за то же завершение; слепое исследование платит $28.7$. \textbf {(b)} Композиция с законом разрыва: в режиме разрыва путник не получает ни одного попадания, пока длится песня, а после разрыва риск возобновляется --- и разрыв происходит на предсказанном экспериментом R2 индексе ребра во всех $19/19$ ячейках}{figure.2}{}}
