\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Безусловные результаты, 840 эпизодов (ячейки дефицита $\times $ случайные/асимметричные планировки $\times $ 20 сидов). Доля успеха под Warp Drive растёт при каждой каденции с непересекающимися интервалами, цензурированное время падает, и быстрый обмен с протоколом обходит базовую «сладкую точку» $K{=}8$ (рисунок~\ref {fig:drive}). Перепись локов показывает сжатие знаменателя условных метрик --- поэтому утверждение сформулировано на безусловных величинах.}}{8}{table.5}\protected@file@percent }
\newlabel{tab:wd}{{5}{8}{Безусловные результаты, 840 эпизодов (ячейки дефицита $\times $ случайные/асимметричные планировки $\times $ 20 сидов). Доля успеха под Warp Drive растёт при каждой каденции с непересекающимися интервалами, цензурированное время падает, и быстрый обмен с протоколом обходит базовую «сладкую точку» $K{=}8$ (рисунок~\ref {fig:drive}). Перепись локов показывает сжатие знаменателя условных метрик --- поэтому утверждение сформулировано на безусловных величинах}{table.5}{}}
