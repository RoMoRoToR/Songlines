\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Одна величина, три субстрата: доля варпа $P(W^{\star }|M^{\star })$ в зависимости от каденции рассылки $K$ на символьной сетке, в непрерывном сценарии VMAS и в текстовом мире с LLM. Кривые почти совпадают --- то, какая часть материализаций коллектива работает на чужих свидетельствах, определяется каденцией обмена, а не субстратом. (Ветвь LLM: 8 эпизодов, только точечные оценки.)}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:universality}{{4}{9}{Одна величина, три субстрата: доля варпа $P(\wstar |\mstar )$ в зависимости от каденции рассылки $K$ на символьной сетке, в непрерывном сценарии VMAS и в текстовом мире с LLM. Кривые почти совпадают --- то, какая часть материализаций коллектива работает на чужих свидетельствах, определяется каденцией обмена, а не субстратом. (Ветвь LLM: 8 эпизодов, только точечные оценки.)}{figure.4}{}}
