\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Four memory topologies. \textbf  {(a)} Independent: per-agent private memory, no exchange. \textbf  {(b)} Shared bus: one global memory, every agent reads and writes each tick. \textbf  {(c)} Central aggregator: private memories plus a hub that merges snapshots into a consensus report. \textbf  {(d)} Peer-to-peer broadcast: private memories with snapshot exchange every $K$ ticks and per-agent merged views.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:architectures}{{1}{2}{Four memory topologies. \textbf {(a)} Independent: per-agent private memory, no exchange. \textbf {(b)} Shared bus: one global memory, every agent reads and writes each tick. \textbf {(c)} Central aggregator: private memories plus a hub that merges snapshots into a consensus report. \textbf {(d)} Peer-to-peer broadcast: private memories with snapshot exchange every $K$ ticks and per-agent merged views}{figure.1}{}}
