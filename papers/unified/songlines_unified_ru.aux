\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Смысловая идентичность при $SE(2)$-системах отсчёта. \textbf  {(a)} Каждый строгий $W^{\star }$-захват семантического стека указывает на настоящую воду ($8/8$); координатный стек делает $992$ захвата, и все --- фантомы ($0/992$); само восстановление системы отсчёта точно в $80/80$ комбинаций свидетель--путник. \textbf  {(b)} Асимметрия отказов в мирах, где опознание невозможно (безликая полоса; $180^\circ $-симметричная планировка, где система отсчёта невосстановима в принципе): семантическая идентичность отказывается захватывать --- отказывает закрытым образом, --- тогда как координатная продолжает уверенно захватывать неверные клетки --- отказывает открытым.}}{63}{figure.18}\protected@file@percent }
\newlabel{p3:fig:identity}{{18}{63}{Смысловая идентичность при $SE(2)$-системах отсчёта. \textbf {(a)} Каждый строгий $\wstar $-захват семантического стека указывает на настоящую воду ($8/8$); координатный стек делает $992$ захвата, и все --- фантомы ($0/992$); само восстановление системы отсчёта точно в $80/80$ комбинаций свидетель--путник. \textbf {(b)} Асимметрия отказов в мирах, где опознание невозможно (безликая полоса; $180^\circ $-симметричная планировка, где система отсчёта невосстановима в принципе): семантическая идентичность отказывается захватывать --- отказывает закрытым образом, --- тогда как координатная продолжает уверенно захватывать неверные клетки --- отказывает открытым}{figure.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {26}{\ignorespaces Абляция словаря ориентиров ($36$ ячеек на плечо, всего $252$; зарегистрированные предсказания A1--A4, все PASS). Обеднение алфавита стоит \emph  {покрытия} --- восстановление превращается в отказ, --- но никогда \emph  {корректности}: каждый выполненный перенос, при любом словаре, идёт через точно восстановленную систему отсчёта. Атрибуция = доля массы ключей консенсусных пар при полном $\Sigma $.}}{63}{table.26}\protected@file@percent }
\newlabel{p3:tab:ablation}{{26}{63}{Абляция словаря ориентиров ($36$ ячеек на плечо, всего $252$; зарегистрированные предсказания A1--A4, все PASS). Обеднение алфавита стоит \emph {покрытия} --- восстановление превращается в отказ, --- но никогда \emph {корректности}: каждый выполненный перенос, при любом словаре, идёт через точно восстановленную систему отсчёта. Атрибуция = доля массы ключей консенсусных пар при полном $\Sigma $}{table.26}{}}
