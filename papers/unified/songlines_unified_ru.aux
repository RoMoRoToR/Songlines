\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Фазовая диаграмма структуры коммуникации по порогу доверия $\tau $ (строки) и каденции $K$ (столбцы; $R=\lfloor H/K\rfloor $ раундов рассылки), $N{=}8$ агентов на кольце взаимодействия, $12$ сидов. \textbf  {Слева:} плотность достижимости (доля упорядоченных пар агентов, чьи свидетельства могут скомпоноваться за $R$ раундов). \textbf  {Справа:} $P(\text  {копредел охватывает всех }N)$, т.е.\ достижимость все-ко-всем. Диагональная граница --- структурный переход: коллектив допускает единый консенсусный объект в области низких $\tau $/низких $K$ и фрагментируется в углу высоких $\tau $/высоких $K$, причём более высокое $\tau $ требует более низкого $K$ (больше раундов), чтобы остаться связным.}}{76}{figure.22}\protected@file@percent }
\newlabel{p4:fig:phase-diagram}{{22}{76}{Фазовая диаграмма структуры коммуникации по порогу доверия $\tau $ (строки) и каденции $K$ (столбцы; $R=\lfloor H/K\rfloor $ раундов рассылки), $N{=}8$ агентов на кольце взаимодействия, $12$ сидов. \textbf {Слева:} плотность достижимости (доля упорядоченных пар агентов, чьи свидетельства могут скомпоноваться за $R$ раундов). \textbf {Справа:} $P(\text {копредел охватывает всех }N)$, т.е.\ достижимость все-ко-всем. Диагональная граница --- структурный переход: коллектив допускает единый консенсусный объект в области низких $\tau $/низких $K$ и фрагментируется в углу высоких $\tau $/высоких $K$, причём более высокое $\tau $ требует более низкого $K$ (больше раундов), чтобы остаться связным}{figure.22}{}}
