\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Безусловные результаты, 840 эпизодов (ячейки дефицита $\times $ случайные/асимметричные планировки $\times $ 20 сидов). Доля успеха под Warp Drive растёт при каждой каденции с непересекающимися интервалами, цензурированное время падает, и быстрый обмен с протоколом обходит базовую «сладкую точку» $K{=}8$ (рисунок~\ref {p2:fig:drive}). Перепись локов показывает сжатие знаменателя условных метрик --- поэтому утверждение сформулировано на безусловных величинах.}}{52}{table.22}\protected@file@percent }
\newlabel{p2:tab:wd}{{22}{52}{Безусловные результаты, 840 эпизодов (ячейки дефицита $\times $ случайные/асимметричные планировки $\times $ 20 сидов). Доля успеха под Warp Drive растёт при каждой каденции с непересекающимися интервалами, цензурированное время падает, и быстрый обмен с протоколом обходит базовую «сладкую точку» $K{=}8$ (рисунок~\ref {p2:fig:drive}). Перепись локов показывает сжатие знаменателя условных метрик --- поэтому утверждение сформулировано на безусловных величинах}{table.22}{}}
