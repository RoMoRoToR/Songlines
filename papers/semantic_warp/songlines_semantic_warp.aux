\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces $\varphi $-stratified completion vs.\ broadcast cadence $K$ (dedicated peer sweep: scarcity cells, random layouts, 20 seeds, episode-cluster bootstrap CIs). As $K$ shrinks, the warp share $P(W^{\star }|M^{\star })$ grows from $0.11$ to $0.55$ while $P(C^{\star }|W^{\star })$ stays below $0.05$ and the own-stratum rate stays flat: the completion collapse of fast sharing is concentrated in the $W^{\star }$ stratum, giving the companion paper's bottleneck shift its mechanistic reading. The share uptick at $K{=}16$ (broadcasts are rare, but agents also discover little on their own) is reported as observed.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:strata}{{1}{4}{$\varphi $-stratified completion vs.\ broadcast cadence $K$ (dedicated peer sweep: scarcity cells, random layouts, 20 seeds, episode-cluster bootstrap CIs). As $K$ shrinks, the warp share $P(\wstar |\mstar )$ grows from $0.11$ to $0.55$ while $P(\cstar |\wstar )$ stays below $0.05$ and the own-stratum rate stays flat: the completion collapse of fast sharing is concentrated in the $\wstar $ stratum, giving the companion paper's bottleneck shift its mechanistic reading. The share uptick at $K{=}16$ (broadcasts are rare, but agents also discover little on their own) is reported as observed}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Provenance strata of completion under scarcity ($N>M$), full runs. Warp locks complete an order of magnitude less often than own-evidence locks; all CI pairs are disjoint. (H-W1 confirmed.)}}{4}{table.1}\protected@file@percent }
\newlabel{tab:hw1}{{1}{4}{Provenance strata of completion under scarcity ($N>M$), full runs. Warp locks complete an order of magnitude less often than own-evidence locks; all CI pairs are disjoint. (H-W1 confirmed.)}{table.1}{}}
