\newlabel{tab:meta-eval}{{6}{16}{Blinded fault localization: injected fault, ground-truth stage, and correct-localization count over the three stacks, per model. ``Neutralized'': the fault does not change qwen's behaviour (the staleness marker is heeded), so the blind rule reads ``none''}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Second-model replication (qwen3:4b, 20 episodes per cell, identical episodes/tools/budgets; thinking disabled request-level for budget parity, recorded in the registration). Entries are marginal event frequencies $f(E)$ as in Table~\ref {tab:external} --- not chain-rule links. Structural zeros transfer exactly; behavioural rates differ from llama3.1 (Table~\ref {tab:external}) in the direction the $M_1$ diagnostic explains.}}{16}{table.7}\protected@file@percent }
\newlabel{tab:external-qwen}{{7}{16}{Second-model replication (qwen3:4b, 20 episodes per cell, identical episodes/tools/budgets; thinking disabled request-level for budget parity, recorded in the registration). Entries are marginal event frequencies $f(E)$ as in Table~\ref {tab:external} --- not chain-rule links. Structural zeros transfer exactly; behavioural rates differ from llama3.1 (Table~\ref {tab:external}) in the direction the $M_1$ diagnostic explains}{table.7}{}}
