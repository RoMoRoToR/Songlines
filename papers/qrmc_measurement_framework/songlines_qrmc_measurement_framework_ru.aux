\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Диагностика бейзлайна обученной коммуникации. \emph  {Слева:} кривая обучения CommNet (сглаженная доля успеха по окну в 100 эпизодов) на 2000 обучающих эпизодов; успех остаётся ниже 0.25 на всём протяжении. Пунктирная линия --- символьная пировая архитектура при $K\!=\!8$ на том же сценарии для сравнения. \emph  {Справа:} профиль Q/R/M/C обученного CommNet на 50 отложенных сидах против символьного peer при $K\!=\!8$. $Q^\star $ насыщен на $1.0$ у CommNet (вырожден по построению); $R/M$ схлопываются вместе; только у символьной архитектуры условные частоты разделены.}}{36}{figure.11}\protected@file@percent }
\newlabel{fig:commnet}{{11}{36}{Диагностика бейзлайна обученной коммуникации. \emph {Слева:} кривая обучения CommNet (сглаженная доля успеха по окну в 100 эпизодов) на 2000 обучающих эпизодов; успех остаётся ниже 0.25 на всём протяжении. Пунктирная линия --- символьная пировая архитектура при $K\!=\!8$ на том же сценарии для сравнения. \emph {Справа:} профиль Q/R/M/C обученного CommNet на 50 отложенных сидах против символьного peer при $K\!=\!8$. $Q^\star $ насыщен на $1.0$ у CommNet (вырожден по построению); $R/M$ схлопываются вместе; только у символьной архитектуры условные частоты разделены}{figure.11}{}}
