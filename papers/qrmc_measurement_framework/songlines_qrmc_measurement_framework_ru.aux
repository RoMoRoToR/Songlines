\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces SOTA-покрытие для Статьи 1. «Инструментировано» означает, что прогон эмитирует операциональные события $Q^\star ,R^\star ,M^\star ,C^\star $, используемые Определением~1.}}{39}{table.15}\protected@file@percent }
\newlabel{tab:sota-coverage}{{15}{39}{SOTA-покрытие для Статьи 1. «Инструментировано» означает, что прогон эмитирует операциональные события $Q^\star ,R^\star ,M^\star ,C^\star $, используемые Определением~1}{table.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Многоагентные оракульные интервенции на случаях дефицита при трёх каденциях. Среднее время до успеха (и доля успеха), усреднённые по $(N,T)\in \{(3,2),(5,3),(8,5)\}$, двум раскладкам (асимметричная, случайная), 15 сидам. Оракульное R возвращает истинные позиции воды; оракульное M фиксирует ближайшую реальную воду; \textbf  {оракульное C} гарантирует завершение реальной материализованной фиксации (Приложение~\ref {app:oracle-c-def}). Оракульное C даёт наибольшее сокращение \emph  {времени} (устраняет путь), но наименьший прирост \emph  {успеха} --- завершение есть временная издержка, а не бутылочное горлышко успеха, которое сидит выше по потоку на R/M.}}{40}{table.16}\protected@file@percent }
\newlabel{tab:multi-agent-oracle}{{16}{40}{Многоагентные оракульные интервенции на случаях дефицита при трёх каденциях. Среднее время до успеха (и доля успеха), усреднённые по $(N,T)\in \{(3,2),(5,3),(8,5)\}$, двум раскладкам (асимметричная, случайная), 15 сидам. Оракульное R возвращает истинные позиции воды; оракульное M фиксирует ближайшую реальную воду; \textbf {оракульное C} гарантирует завершение реальной материализованной фиксации (Приложение~\ref {app:oracle-c-def}). Оракульное C даёт наибольшее сокращение \emph {времени} (устраняет путь), но наименьший прирост \emph {успеха} --- завершение есть временная издержка, а не бутылочное горлышко успеха, которое сидит выше по потоку на R/M}{table.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces REINFORCE против PPO CommNet против символьного peer ($K{=}8$) на сценарии дефицита ($N{=}3$, $T{=}2$, асимметричная, опасность $0.05$). PPO конкурентоспособен по доле успеха, но всё равно демонстрирует Q-насыщение и коллапс R/M --- диагностическое утверждение верифицировано, а не постулировано.}}{40}{table.17}\protected@file@percent }
\newlabel{tab:ppo-commnet}{{17}{40}{REINFORCE против PPO CommNet против символьного peer ($K{=}8$) на сценарии дефицита ($N{=}3$, $T{=}2$, асимметричная, опасность $0.05$). PPO конкурентоспособен по доле успеха, но всё равно демонстрирует Q-насыщение и коллапс R/M --- диагностическое утверждение верифицировано, а не постулировано}{table.17}{}}
