\newlabel{p1:tab:meta-eval}{{6}{17}{Blinded fault localization: injected fault, ground-truth stage, and correct-localization count over the three stacks, per model. ``Neutralized'': the fault does not change qwen's behavior (the staleness marker is heeded), so the blind rule reads ``none''}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Second-model replication (qwen3:4b, 20 episodes per cell, identical episodes/tools/budgets; thinking disabled request-level for budget parity, recorded in the pre-run specification). Entries are marginal event frequencies $f(E)$ as in Table~\ref {p1:tab:external} --- not chain-rule links. Structural zeros transfer exactly; behavioral rates differ from llama3.1 (Table~\ref {p1:tab:external}) in the direction the $M_1$ diagnostic explains.}}{17}{table.7}\protected@file@percent }
\newlabel{p1:tab:external-qwen}{{7}{17}{Second-model replication (qwen3:4b, 20 episodes per cell, identical episodes/tools/budgets; thinking disabled request-level for budget parity, recorded in the pre-run specification). Entries are marginal event frequencies $f(E)$ as in Table~\ref {p1:tab:external} --- not chain-rule links. Structural zeros transfer exactly; behavioral rates differ from llama3.1 (Table~\ref {p1:tab:external}) in the direction the $M_1$ diagnostic explains}{table.7}{}}
