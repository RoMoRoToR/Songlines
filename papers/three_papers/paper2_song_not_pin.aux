\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Warp Drive on unconditional metrics (840 episodes; bootstrap CIs). \textbf  {(a)} Success rate rises at every cadence with disjoint CIs, and every fast-$K$ protocol arm exceeds the $K{=}8$ sweet-spot baseline (dashed). \textbf  {(b)} Censored time-to-success falls correspondingly. The claim that the protocol removes the main argument against fast sharing rests on these unconditional quantities, not on the (denominator-sensitive) conditional rates.}}{8}{figure.3}\protected@file@percent }
\newlabel{p2:fig:drive}{{3}{8}{Warp Drive on unconditional metrics (840 episodes; bootstrap CIs). \textbf {(a)} Success rate rises at every cadence with disjoint CIs, and every fast-$K$ protocol arm exceeds the $K{=}8$ sweet-spot baseline (dashed). \textbf {(b)} Censored time-to-success falls correspondingly. The claim that the protocol removes the main argument against fast sharing rests on these unconditional quantities, not on the (denominator-sensitive) conditional rates}{figure.3}{}}
