\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Поархитектурные условные частоты (сверху) и среднее время до успеха (снизу) из развертки в 35{,}640 прогонов. Общая шина, центральный агрегатор и быстрая одноранговая рассылка ($K \le 4$) живут в режиме насыщения M / коллапса C; независимая и медленная одноранговая ($K \ge 16$) --- в режиме дефицита M / насыщения C. Среднее время до успеха имеет чистый внутренний минимум при $K{=}8$ ($7.47$ тика), ниже базового уровня независимых агентов ($8.02$).}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:conditional-rates}{{4}{13}{Поархитектурные условные частоты (сверху) и среднее время до успеха (снизу) из развертки в 35{,}640 прогонов. Общая шина, центральный агрегатор и быстрая одноранговая рассылка ($K \le 4$) живут в режиме насыщения M / коллапса C; независимая и медленная одноранговая ($K \ge 16$) --- в режиме дефицита M / насыщения C. Среднее время до успеха имеет чистый внутренний минимум при $K{=}8$ ($7.47$ тика), ниже базового уровня независимых агентов ($8.02$)}{figure.4}{}}
