\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Диагностика базового метода обученной коммуникации. \emph  {Слева:} кривая обучения CommNet (сглаженная доля успеха по окну в 100 эпизодов) за 2000 обучающих эпизодов; успех остается ниже 0.25 на всем протяжении. Пунктирная линия --- символьная одноранговая архитектура при $K\!=\!8$ на том же сценарии для сравнения. \emph  {Справа:} профиль Q/R/M/C обученного CommNet на 50 отложенных сидах против символьной одноранговой при $K\!=\!8$. $Q^\star $ насыщено на уровне $1.0$ у CommNet (вырождено по построению); $R/M$ схлопываются вместе; только на символьной архитектуре условные частоты разделены.}}{28}{figure.10}\protected@file@percent }
\newlabel{fig:commnet}{{10}{28}{Диагностика базового метода обученной коммуникации. \emph {Слева:} кривая обучения CommNet (сглаженная доля успеха по окну в 100 эпизодов) за 2000 обучающих эпизодов; успех остается ниже 0.25 на всем протяжении. Пунктирная линия --- символьная одноранговая архитектура при $K\!=\!8$ на том же сценарии для сравнения. \emph {Справа:} профиль Q/R/M/C обученного CommNet на 50 отложенных сидах против символьной одноранговой при $K\!=\!8$. $Q^\star $ насыщено на уровне $1.0$ у CommNet (вырождено по построению); $R/M$ схлопываются вместе; только на символьной архитектуре условные частоты разделены}{figure.10}{}}
\@writefile{toc}{\contentsline {paragraph}{Вариант PPO: структурная вырожденность проверена при конкурентоспособном успехе.}{28}{section*.26}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces REINFORCE против PPO CommNet против символьной одноранговой ($K{=}8$) на сценарии дефицита ($N{=}3$, $T{=}2$, асимметричная раскладка, опасность $0.05$). PPO конкурентоспособен по доле успеха, но по-прежнему демонстрирует насыщение Q и коллапс R/M --- диагностическое утверждение проверено, а не постулировано.}}{29}{table.9}\protected@file@percent }
\newlabel{tab:ppo-commnet}{{9}{29}{REINFORCE против PPO CommNet против символьной одноранговой ($K{=}8$) на сценарии дефицита ($N{=}3$, $T{=}2$, асимметричная раскладка, опасность $0.05$). PPO конкурентоспособен по доле успеха, но по-прежнему демонстрирует насыщение Q и коллапс R/M --- диагностическое утверждение проверено, а не постулировано}{table.9}{}}
