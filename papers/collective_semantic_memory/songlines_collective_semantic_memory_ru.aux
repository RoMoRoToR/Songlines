\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Четыре топологии памяти. \textbf  {(a)} Независимая: приватная память у каждого агента, обмена нет. \textbf  {(b)} Общая шина: одна глобальная память, каждый агент читает и пишет на каждом такте. \textbf  {(c)} Центральный агрегатор: приватные памяти плюс хаб, сливающий снимки в консенсусный отчёт. \textbf  {(d)} Пиринговая рассылка: приватные памяти с обменом снимками каждые $K$ тактов и слитыми представлениями у каждого агента.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:architectures}{{1}{3}{Четыре топологии памяти. \textbf {(a)} Независимая: приватная память у каждого агента, обмена нет. \textbf {(b)} Общая шина: одна глобальная память, каждый агент читает и пишет на каждом такте. \textbf {(c)} Центральный агрегатор: приватные памяти плюс хаб, сливающий снимки в консенсусный отчёт. \textbf {(d)} Пиринговая рассылка: приватные памяти с обменом снимками каждые $K$ тактов и слитыми представлениями у каждого агента}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Условные показатели и среднее время до успеха по развёртке из 35\,640 запусков. Быстрый обмен улучшает материализацию целей, но вредит завершению из-за конкуренции; медленный обмен имеет противоположный профиль. Среднее время до успеха имеет внутренний оптимум при $K{=}8$.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:conditional-rates}{{2}{3}{Условные показатели и среднее время до успеха по развёртке из 35\,640 запусков. Быстрый обмен улучшает материализацию целей, но вредит завершению из-за конкуренции; медленный обмен имеет противоположный профиль. Среднее время до успеха имеет внутренний оптимум при $K{=}8$}{figure.2}{}}
